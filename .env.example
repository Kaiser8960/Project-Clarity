# Supabase — get these from your Supabase project
# Dashboard → Project Settings → API

# Your project URL (public, safe to share)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key (public, safe to share)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key (KEEP SECRET — gives full DB access, bypasses RLS)
# Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Gemini API Key — used for contract risk analysis and OCR
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
